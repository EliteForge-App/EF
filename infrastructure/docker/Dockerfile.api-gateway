# syntax=docker/dockerfile:1

ARG NODE_VERSION=22

# -----------------------------------------------------------------------------
# Builder — instala deps del workspace @ef/backend y compila api-gateway
# -----------------------------------------------------------------------------
FROM node:${NODE_VERSION}-alpine AS builder

RUN apk add --no-cache python3 make g++

WORKDIR /app

# Manifests del monorepo (npm ci exige lockfile + todos los workspaces declarados)
COPY package.json package-lock.json ./
COPY apps/backend/package.json apps/backend/package.json
COPY apps/mobile/package.json apps/mobile/package.json

RUN npm ci --workspace=@ef/backend --include-workspace-root

# Código fuente del backend NestJS (apps/ + libs/ internos)
COPY apps/backend/nest-cli.json apps/backend/tsconfig.build.json apps/backend/tsconfig.json ./apps/backend/
COPY apps/backend/apps ./apps/backend/apps
COPY apps/backend/libs ./apps/backend/libs

WORKDIR /app/apps/backend
RUN npm run build:gateway

# -----------------------------------------------------------------------------
# Production — solo dependencias de producción + artefacto compilado
# -----------------------------------------------------------------------------
FROM node:${NODE_VERSION}-alpine AS production

RUN apk add --no-cache python3 make g++

WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/backend/package.json apps/backend/package.json
COPY apps/mobile/package.json apps/mobile/package.json

ENV NODE_ENV=production

RUN npm ci --workspace=@ef/backend --include-workspace-root --omit=dev \
  && apk del python3 make g++

COPY --from=builder /app/apps/backend/dist ./apps/backend/dist

WORKDIR /app/apps/backend

EXPOSE 3000

CMD ["node", "dist/apps/api-gateway/apps/api-gateway/src/main.js"]
