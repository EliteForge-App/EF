# Local: copia como apps/web/.env.local

# Backend NestJS (jugadores + admin)
API_GATEWAY_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_SITE_URL=http://localhost:5175

# Bypass portal admin sin backend (solo NODE_ENV !== production)
# EF_ADMIN_DEV_BYPASS=true

# Producción Hostinger: configura en hPanel → Environment variables y redeploy
# Nunca actives EF_ADMIN_DEV_BYPASS en producción.
